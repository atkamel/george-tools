{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "george (GeorgeCode colours)",
  "comment": "A port of GeorgeCode's george.tmLanguage (Ankit-Patel10/GeorgeCode, 2018), rule for rule and scope for scope. Only `//` comments and the current #check methods were added.",
  "scopeName": "source.grg.classic",
  "fileTypes": [
    "grg"
  ],
  "patterns": [
    {
      "comment": "#q, etc",
      "begin": "#q|#u|#a",
      "end": "\\n",
      "name": "keyword.operator.source.grg"
    },
    {
      "comment": "#check PROP, etc",
      "match": "^#check (PROP|PRED|PREDTYPES|SEM|SEM_T|SEM_F|SEM_CE|TP|ND|ST|Z|PC|PCrun|PCrunVerbose|NONE)\\s",
      "name": "variable.parameter.source.grg"
    },
    {
      "comment": "% comment (old george)",
      "begin": "%",
      "end": "\\n",
      "name": "comment.source.grg"
    },
    {
      "comment": "// comment",
      "match": "//.*$",
      "name": "comment.source.grg"
    },
    {
      "comment": "/* comment */",
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.source.grg"
    },
    {
      "comment": "assume, case, disprove, etc",
      "match": "(disprove|assume|for some|for every|case|equals|inductionstep)\\s",
      "name": "keyword.control.source.grg"
    },
    {
      "comment": "all keywords",
      "match": "(AND|NOT|IMP|forall.*?\\.|exists.*?\\.|true|false|premise|univ|sube|empty|\\ssub|\\sunion|\\sin|\\sinter|pow\\(.*?\\)|dom\\(.*?\\)|ran\\(.*?\\)|card\\(.*?\\)|iter\\(.*?\\)|gen_U|gen_I|closed|schema|begin|pred|\\send|assert|while.*?do|if.*?then|else|for.*?until.*?do)\\s",
      "name": "support.function.grg"
    },
    {
      "comment": "by (something)",
      "match": "by (and_e|and_i|or_i|or_e|imp_i|imp_e|not_e|cases|comm|assoc|contr|lem|impl|contrapos|simp1|simp2|distr|dm|neg|equiv|idemp|raa|not_not_i|not_not_e|iff_i|trans|iff_e|iff_mp|lem|forall_i|forall_e|exists_i|exists_e|and_nb|not_and_br|or_br|not_or_nb|imp_br|not_imp_nb|not_not_nb|iff_br|not_iff_br|forall_nb|not_forall_nb|not_exists_nb|exists_nb|set|arith|eq_e)",
      "name": "constant.language.source.grg"
    },
    {
      "comment": "by magic",
      "match": "\\bby magic\\b",
      "name": "invalid.illegal.source.grg"
    },
    {
      "comment": "on (something)",
      "match": "\\bon\\b",
      "name": "variable.parameter.grg"
    },
    {
      "comment": "line numbers",
      "match": "^\\s*[0-9]+?\\)",
      "name": "string.source.grg"
    }
  ]
}
