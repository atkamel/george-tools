{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "george",
  "scopeName": "source.grg",
  "fileTypes": ["grg"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#labels" },
    { "include": "#proof-keywords" },
    { "include": "#rules" },
    { "include": "#z-keywords" },
    { "include": "#pc-keywords" },
    { "include": "#quantifiers" },
    { "include": "#set-keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.grg", "match": "//.*$" },
        { "name": "comment.block.grg", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "^(#check)\\s+(PROP|PRED|PREDTYPES|SEM|SEM_T|SEM_F|SEM_CE|TP|ND|ST|Z|PC|PCrun|PCrunVerbose|NONE)\\b",
          "captures": {
            "1": { "name": "keyword.control.directive.grg" },
            "2": { "name": "entity.name.type.method.grg" }
          }
        },
        {
          "match": "^(#u|#a|#q)\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.grg" },
            "2": { "name": "string.unquoted.directive-argument.grg" }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        { "name": "entity.name.tag.label.grg", "match": "^\\s*[A-Za-z0-9_]+\\)" }
      ]
    },
    "proof-keywords": {
      "patterns": [
        {
          "name": "keyword.control.proof.grg",
          "match": "\\b(premise|assume|disprove|case|for\\s+some|for\\s+every|inductionstep|closed|by|on)\\b"
        },
        { "name": "invalid.illegal.magic.grg", "match": "\\bmagic\\b" }
      ]
    },
    "rules": {
      "patterns": [
        {
          "name": "support.function.rule.grg",
          "match": "(?<=\\bby\\s)\\s*[a-z][a-z0-9_]*\\b"
        }
      ]
    },
    "z-keywords": {
      "patterns": [
        { "name": "keyword.control.z.grg", "match": "\\b(schema|begin|pred|end|Delta|Xi)\\b" },
        { "name": "keyword.operator.z.grg", "match": "::=|;;" }
      ]
    },
    "pc-keywords": {
      "patterns": [
        { "name": "keyword.control.pc.grg", "match": "\\b(proc|fun|if|then|else|while|do|assert|return)\\b" },
        { "name": "keyword.operator.assignment.grg", "match": ":=" }
      ]
    },
    "quantifiers": {
      "patterns": [
        { "name": "keyword.operator.quantifier.grg", "match": "\\b(forall|exists)\\b" }
      ]
    },
    "set-keywords": {
      "patterns": [
        {
          "name": "keyword.operator.set.grg",
          "match": "\\b(in|sube|sub|union|inter|compl|diff|card|pow|gen_U|gen_I|prod|dom|ran|id|iter|empty|univ)\\b"
        },
        { "name": "keyword.operator.relation.grg", "match": "<\\||<-\\||\\|>|\\|->|\\(\\+\\)|\\(\\||\\|\\)|-\\|->|-->>|-->|~" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.grg", "match": "\\b(nat|bool|int)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.grg", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.truth-value.grg", "match": "(?<=:=\\s*)\\b(T|F)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.goal.grg", "match": "<->|\\|-|\\|=|<==>" },
        { "name": "keyword.operator.logical.grg", "match": "<=>|=>|&|\\||!" },
        { "name": "keyword.operator.comparison.grg", "match": "!=|>=|<=|=|<|>" },
        { "name": "keyword.operator.arithmetic.grg", "match": "\\+|-|\\*|/|\\^" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.grg", "match": "\\b[0-9]+\\b" }
      ]
    }
  }
}
