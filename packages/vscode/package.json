{
  "name": "george-vscode",
  "displayName": "george",
  "description": "Run george (SE212, University of Waterloo) on .grg files from VS Code: syntax highlighting, Run button, diagnostics, assignment downloads.",
  "version": "0.1.0",
  "publisher": "george-tools",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atkamel/george-tools.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/atkamel/george-tools#readme",
  "bugs": {
    "url": "https://github.com/atkamel/george-tools/issues"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:george",
    "onLanguage:george-classic",
    "onLanguage:george-plain"
  ],
  "contributes": {
    "languages": [
      {
        "id": "george",
        "aliases": [
          "george",
          "grg"
        ],
        "extensions": [
          ".grg"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "george-classic",
        "aliases": [
          "george (GeorgeCode colours)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "george-plain",
        "aliases": [
          "george (no highlighting)"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "george",
        "scopeName": "source.grg",
        "path": "./syntaxes/george.tmLanguage.json"
      },
      {
        "language": "george-classic",
        "scopeName": "source.grg.classic",
        "path": "./syntaxes/george-classic.tmLanguage.json"
      },
      {
        "language": "george-plain",
        "scopeName": "source.grg.plain",
        "path": "./syntaxes/george-plain.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "george.run",
        "title": "Run George",
        "category": "george",
        "icon": "$(run)"
      },
      {
        "command": "george.login",
        "title": "Log in to the course site",
        "category": "george"
      },
      {
        "command": "george.setUserIds",
        "title": "Set group user ids (#u)",
        "category": "george"
      },
      {
        "command": "george.download",
        "title": "Sync: download new assignment files",
        "category": "george",
        "icon": "$(cloud-download)"
      },
      {
        "command": "george.downloadFile",
        "title": "Download this file",
        "category": "george"
      },
      {
        "command": "george.refreshAssignments",
        "title": "Refresh",
        "category": "george",
        "icon": "$(refresh)"
      },
      {
        "command": "george.runAll",
        "title": "Run George on all files",
        "category": "george",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "george.run",
          "when": "resourceLangId =~ /^george(-classic|-plain)?$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "george.run",
          "when": "resourceLangId =~ /^george(-classic|-plain)?$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "george.download",
          "when": "view == georgeAssignments",
          "group": "navigation@1"
        },
        {
          "command": "george.runAll",
          "when": "view == georgeAssignments",
          "group": "navigation@2"
        },
        {
          "command": "george.refreshAssignments",
          "when": "view == georgeAssignments",
          "group": "navigation@3"
        },
        {
          "command": "george.login",
          "when": "view == georgeAssignments",
          "group": "1_session@1"
        },
        {
          "command": "george.setUserIds",
          "when": "view == georgeAssignments",
          "group": "1_session@2"
        }
      ],
      "view/item/context": [
        {
          "command": "george.downloadFile",
          "when": "view == georgeAssignments && viewItem == remoteFile",
          "group": "inline"
        },
        {
          "command": "george.runAll",
          "when": "view == georgeAssignments && viewItem == group",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "george.downloadFile",
          "when": "false"
        },
        {
          "command": "george.refreshAssignments",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "george.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceLangId =~ /^george(-classic|-plain)?$/"
      }
    ],
    "views": {
      "george": [
        {
          "id": "georgeAssignments",
          "name": "Workspace",
          "contextualTitle": "George"
        }
      ]
    },
    "configuration": {
      "title": "george",
      "properties": {
        "george.timeoutMs": {
          "type": "number",
          "default": 900000,
          "description": "How long to wait for george before giving up, in milliseconds."
        },
        "george.browser": {
          "type": "string",
          "enum": [
            "auto",
            "chrome",
            "edge",
            "firefox"
          ],
          "default": "auto",
          "description": "Browser to open for the course-site login. auto picks the first of Chrome, Edge, Firefox that is installed."
        },
        "george.browserPath": {
          "type": "string",
          "default": "",
          "description": "Path to a browser executable to use for login instead of searching."
        },
        "george.highlighting": {
          "type": "string",
          "enum": [
            "default",
            "georgecode",
            "off"
          ],
          "default": "default",
          "enumDescriptions": [
            "Directives, keywords, rule names, connectives and comments. Line labels and numbers stay quiet.",
            "The colours GeorgeCode (2018) used, rule for rule.",
            "No syntax colours. Run George, diagnostics and downloads still work."
          ],
          "description": "How .grg files are coloured. Applies to files as they are opened."
        },
        "george.folder": {
          "type": "string",
          "default": "",
          "description": "Subfolder of the workspace where assignment files live, if not the workspace root. Relative path, for example \"se212\"."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "george",
          "title": "George",
          "icon": "media/george-g.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "georgeAssignments",
        "when": "george.state == noFolder",
        "contents": "Open the folder you keep your SE212 work in.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "georgeAssignments",
        "when": "george.state == empty",
        "contents": "This folder has no assignment files yet. Download every assignment and homework file into it, in the same layout as the course site. Files already here are never overwritten.\n[Download all assignments](command:george.download)\nYou will be asked to log in and for your group's WatIAM ids if they are not saved."
      }
    ]
  },
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "package": "node package.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0"
  },
  "devDependencies": {
    "@george-tools/core": "0.1.0",
    "@types/vscode": "^1.85.0"
  }
}
